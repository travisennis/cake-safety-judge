#!/bin/sh
# Check that the gate describes itself and report whether Cake can find it.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$root/bin/cake-safety-judge" ]; then
    path="$root/bin/cake-safety-judge"
    echo "binary: $path (local build; Cake uses the PATH copy when installed)"
elif command -v cake-safety-judge >/dev/null 2>&1; then
    path=$(command -v cake-safety-judge)
    echo "binary: $path (on PATH; Cake can select it as the safety gate)"
else
    echo "cake-safety-judge: no binary found" >&2
    echo "run 'just build' or 'just install'" >&2
    exit 1
fi

describe=$("$path" describe)
printf '%s\n' "$describe"

for expected in \
    '"protocol":"cake-gate/1"' \
    '"name":"safety"' \
    '"actions":["bash.exec"]' \
    '"transports":["stdio"]' \
    '"calibration-identity"'
do
    if ! printf '%s' "$describe" | grep -qF "$expected"; then
        echo "doctor: describe is missing $expected" >&2
        exit 1
    fi
done

if command -v cake >/dev/null 2>&1; then
    echo "cake: $(command -v cake)"
    echo "note: Cake selects the safety gate when no explicit pipeline is configured; run 'cake gates list' for the live state."
fi
echo "ok"
