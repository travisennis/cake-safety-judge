#!/bin/sh
# Install the gate into ~/bin (or BIN_DIR) and verify discovery.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target=${BIN_DIR:-"$HOME/bin"}
cd "$root"

mkdir -p "$target"
go build -trimpath -o "$target/cake-safety-judge" ./cmd/cake-safety-judge
echo "installed $target/cake-safety-judge"

if ! command -v cake-safety-judge >/dev/null 2>&1; then
    echo "warning: $target is not on PATH; Cake cannot select the gate by name" >&2
fi
"$root/bin/doctor" "$target/cake-safety-judge"
